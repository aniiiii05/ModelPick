# The AI reader that classifies prompts (it never answers them). All optional: with no provider
# configured, the app uses its offline classifier. On Cloudflare, set keys as Secrets, never as vars.

# Which provider: anthropic | google | openai | openai-compatible.
# Leave blank to use the first provider below whose key is set.
EXTRACTOR_PROVIDER=

# Model id for that provider. Defaults: anthropic claude-haiku-5-5, google gemini-3.8-flash.
# Required for openai and openai-compatible (e.g. an OpenRouter id like google/gemini-3.8-flash).
EXTRACTOR_MODEL=

# Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Google Gemini (aistudio.google.com/apikey). GEMINI_API_KEY also works.
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenAI (platform.openai.com)
OPENAI_API_KEY=

# Any OpenAI-compatible API: OpenRouter, Groq, Together, a local server...
EXTRACTOR_BASE_URL=
EXTRACTOR_API_KEY=

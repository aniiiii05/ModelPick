{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "modelpick",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    // Node.js APIs for the Next.js server runtime.
    "nodejs_compat",
    // fetch() may only reach public addresses.
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Used by OpenNext for cache revalidation; must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "modelpick"
    }
  ],
  // No vars: the AI reader is configured in the Cloudflare dashboard (see .env.example). Put
  // EXTRACTOR_PROVIDER / EXTRACTOR_MODEL there as plain variables and API keys as Secrets.
  "observability": {
    "enabled": true
  }
}
